#!/usr/local/bin/bash
set -euo pipefail

CONFIG="${LITELLM_CONFIG:-$HOME/.config/litellm/config.yaml}"

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

if [ ! -f "$CONFIG" ]; then
    echo "LiteLLM config not found: $CONFIG" >&2
    exit 1
fi

# Extract unique environment variable names from e.g. :
# api_key: os.environ/GEMINI_API_KEY
mapfile -t REQUIRED_VARS < <(
    grep -rhoE 'os\.environ/[A-Z0-9_]+' "$CONFIG" |
    sed 's#os\.environ/##' |
    sort -u
)

# load secret that has been added like this:
# security add-generic-password \
#   -U \
#   -a "$USER" \
#   -s GEMINI_API_KEY \
#   -w 'your-gemini-key'

load_secret() {
    local var="$1"

    local value
    value="$(
        security find-generic-password \
            -a "$USER" \
            -s "$var" \
            -w 2>/dev/null || true
    )"

    if [ -z "$value" ]; then
        echo "Missing Keychain entry: $var" >&2
        return 1
    fi

    echo "Loaded and exporting key for $var"
    export "$var=$value"
}

for var in "${REQUIRED_VARS[@]}"; do
    load_secret "$var"
done

echo "Starting LiteLLM"

exec litellm \
    --config "$CONFIG" \
    --host 127.0.0.1 \
    --port 4000
