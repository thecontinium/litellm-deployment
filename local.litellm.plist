<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.txt">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.litellm</string>

    <key>ProgramArguments</key>
    <array>
        <string>HOME_DIR/.local/bin/litellm-service</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>HOME_DIR/Library/Logs/litellm.log</string>
    <key>StandardErrorPath</key>
    <string>HOME_DIR/Library/Logs/litellm.err.log</string>
</dict>
</plist>
